<section class="m-hero glass-panel" aria-label="球員摘要">
    <div class="m-hero-photo">
        <div class="m-hero-avatar">
            {# 頭像：先試 CDN primary，fallback 至 secondary，最後顯示文字縮寫（見 avatar-fallback.js）#}
            {% set cdn_primary, cdn_secondary = headshot_cdn_urls(player.mlb_id, player.latest_level_is_mlb) %}
            <img src="{{ cdn_primary }}" data-cdn-src="{{ cdn_secondary }}" alt="{{ player_name }}" class="avatar-img" fetchpriority="high">
            <div class="avatar-initials avatar-fallback" aria-hidden="true">{{ player.name_en[:1] }}</div>
        </div>
    </div>

    <div class="m-hero-info">
        <h1>{{ player.name_tw or player.name_en }}</h1>
        <span class="m-hero-name-en">{{ player.name_en }}</span>
        <div class="m-hero-meta">
            <span class="badge {{ 'badge-mlb' if is_mlb(player.level) else 'badge-level' }}">{{ player.level | level_display(player.level_year) }}</span>
            <span>{{ player.team }}</span>
            {% if not page_roles %}
            <span>{% if is_pitcher %}{{ (player.pitch_hand or "R")[:1] }}HP{% else %}{{ (player.bat_side or "?")[:1] }}{% endif %} · {{ player.position }}</span>
            {% endif %}
        </div>
        {% if page_roles %}
        {# 手機寬度放不下同一行，切換獨立成第二行 #}
        <div class="m-hero-meta">
            {% include 'partials/role_toggle.j2' %}
        </div>
        {% endif %}
    </div>

    {% if page_roles %}
    {# display: contents；切換角色時 role-toggle.js 換掉裡面的內容 #}
    <div class="role-slot" id="m-hero-stats-slot">
    {% include 'mobile/sections/m_hero_stats.j2' %}
    </div>
    {% else %}
    {% include 'mobile/sections/m_hero_stats.j2' %}
    {% endif %}
</section>

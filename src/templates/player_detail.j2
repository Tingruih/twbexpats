{% extends 'base.j2' %}

{% block content %}

<div class="page-desktop">
{% set player_name = player.name_tw ~ ' ' ~ player.name_en if player.name_tw else player.name_en %}

{# ── TAB SYSTEM (JS-based for performance) ── #}

{# ── PLAYER HERO ── #}
<div class="profile-hero glass-panel" id="player-hero-{{ player.mlb_id }}">
    <div class="hero-photo-wrap">
        <div class="hero-avatar" id="avatar-{{ player.mlb_id }}">
            {# 頭像：先試 CDN primary，fallback 至 secondary，最後顯示文字縮寫（見 avatar-fallback.js）#}
            {% set cdn_primary, cdn_secondary = headshot_cdn_urls(player.mlb_id, player.latest_level_is_mlb) %}
            <img src="{{ cdn_primary }}" data-cdn-src="{{ cdn_secondary }}" alt="{{ player_name }}" id="headshot-{{ player.mlb_id }}" class="avatar-img" fetchpriority="high">
            <div class="avatar-initials avatar-fallback" id="initials-{{ player.mlb_id }}" aria-hidden="true">{{ player.name_en[:1] }}</div>
        </div>
    </div>

    <div class="hero-info">
        <h1>{{ player.name_tw or player.name_en }}
            <span class="hero-name-en">{{ player.name_en }}</span>
        </h1>
        <div class="hero-meta">
            <span class="badge {{ 'badge-mlb' if is_mlb(player.level) else 'badge-level' }}">{{ player.level | level_display(player.level_year) }}</span>
            <span class="hero-team">{{ player.team }}</span>
            {% if page_roles %}
            {% include 'partials/role_toggle.j2' %}
            {% else %}
            <span class="hero-pos">{% if is_pitcher %}{{ (player.pitch_hand or "R")[:1] }}HP{% else %}{{ (player.bat_side or "?")[:1] }}{% endif %} · {{ player.position }}</span>
            {% endif %}
        </div>
    </div>

    {# ── KEY STATS STRIP ── #}
    {% if page_roles %}
    {# display: contents，不影響 hero 版面；切換角色時 role-toggle.js 換掉裡面的內容 #}
    <div class="role-slot" id="hero-stats-slot">
    {% include 'partials/hero_stats_strip.j2' %}
    </div>
    {% else %}
    {% include 'partials/hero_stats_strip.j2' %}
    {% endif %}
</div>

{# ── TAB NAV ── #}
<div class="tab-nav glass-panel">
    <label data-tab="bio" class="tab-label tab-label--active">球員資料</label>
    <label data-tab="stats" class="tab-label">基礎數據</label>
    <label data-tab="gamelogs" class="tab-label">比賽紀錄</label>
    <label data-tab="advanced" class="tab-label">進階數據</label>
    <label data-tab="fielding" class="tab-label">守備數據</label>
    <label data-tab="plot" class="tab-label">數據圖表</label>
</div>

{% include 'tabs/tab_bio.j2' %}
{% include 'tabs/tab_stats.j2' %}
{% include 'tabs/tab_gamelogs.j2' %}
{% include 'tabs/tab_advanced.j2' %}
{% include 'tabs/tab_fielding.j2' %}
{% include 'tabs/tab_plot.j2' %}

</div>

<div class="page-mobile">
    {% include 'mobile/m_player_detail.j2' %}
</div>
{# 次要角色的各區塊內容（inert <template>，見 partials/role_alt_views.j2） #}
{% for view in role_alt_views %}
{{ view.html }}
{% endfor %}
{% endblock %}

{% block extra_scripts %}
{% if page_roles %}
{# 圖表 JSON 也隨角色切換：role-toggle.js 整包換掉這個容器的內容。必須放在
   role-toggle.js 之前：網址帶 ?role= 時該腳本一載入就同步換內容，此時還沒解析到的
   容器 getElementById 找不到，會被略過而留著主要角色的圖表資料 #}
<div id="role-chart-data" hidden>
{% include 'partials/chart_data.j2' %}
{% if player_trend_by_year %}
<script type="application/json" id="player-trend-data">{{ player_trend_by_year|tojson_safe }}</script>
{% endif %}
</div>
{# 投手/打者切換：刻意不用 defer —— 網址帶 ?role= 時要在其他腳本初始化
   （DOMContentLoaded）之前就把內容換成該角色，見 role-toggle.js #}
<script src="{{ static_url('js/role-toggle.js') }}"></script>
{% else %}
{% include 'partials/chart_data.j2' %}
{% endif %}
{# 篩選共用引擎 — 必須在 gamelogs / arsenal / m-gamelogs / m-advanced 之前 #}
<script defer src="{{ static_url('js/filters.js') }}"></script>
<script defer src="{{ static_url('js/stats-table.js') }}"></script>
<script defer src="{{ static_url('js/stats-tooltip.js') }}"></script>
{# KaTeX：頁面 load 後於瀏覽器閒置時背景預抓，不阻塞渲染（只有本頁需要公式） #}
<script defer src="{{ static_url('js/katex-lazy.js') }}"></script>
<script defer src="{{ static_url('js/pitch-log.js') }}"></script>
<script defer src="{{ static_url('js/gamelogs.js') }}"></script>
<script defer src="{{ static_url('js/mobile/m-tabs.js') }}"></script>
<script defer src="{{ static_url('js/mobile/m-accordion.js') }}"></script>
<script defer src="{{ static_url('js/mobile/m-bio.js') }}"></script>
<script defer src="{{ static_url('js/mobile/m-pitch-log.js') }}"></script>
<script defer src="{{ static_url('js/mobile/m-gamelogs.js') }}"></script>
<script defer src="{{ static_url('js/arsenal-filters.js') }}"></script>
<script defer src="{{ static_url('js/mobile/m-advanced.js') }}"></script>
<script defer src="{{ static_url('js/pitcher-charts.js') }}"></script>
<script defer src="{{ static_url('js/pitch-plinko.js') }}"></script>
{# trend_chart_needed：任一角色有走勢圖資料就載入 Chart.js（主要角色沒有、次要角色有時也要） #}
{% if trend_chart_needed %}
<script defer src="https://cdn.jsdelivr.net/npm/chart.js@4.5.1/dist/chart.umd.min.js" integrity="sha384-jb8JQMbMoBUzgWatfe6COACi2ljcDdZQ2OxczGA3bGNeWe+6DChMTBJemed7ZnvJ" crossorigin="anonymous"></script>
{% if not page_roles %}
<script type="application/json" id="player-trend-data">{{ player_trend_by_year|tojson_safe }}</script>
{% endif %}
<script defer src="{{ static_url('js/charts.js') }}"></script>
{% endif %}
<script defer src="{{ static_url('js/mobile/m-charts.js') }}"></script>
<script defer src="{{ static_url('js/tabs.js') }}"></script>
{% endblock %}

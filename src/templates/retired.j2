{% extends 'base.j2' %}
{% import "macros/tags.j2" as tags %}
{% import "macros/search_box.j2" as search %}

{% block content %}

{# 說明區塊右側直接放搜尋框（退休頁沒有排序列，不另開控制列面板） #}
<div class="index-intro glass-panel">
    <div class="index-intro-text">
        <h2 class="index-intro-title">已離美職體系球員</h2>
        <p class="index-intro-desc">
            卡片數據為生涯合計，層級徽章顯示該球員生涯的最高層級
        </p>
    </div>
    {{ search.player_search() }}
</div>

<div class="dashboard-grid" id="player-grid">
    {% for item in player_data %}
    {% set player = item.player %}
    {% set stat = item.stat %}
    {% set player_name = player.name_tw ~ ' ' ~ player.name_en if player.name_tw else player.name_en %}
    <a href="{{ retired_player_url(player.mlb_id) }}" class="player-card glass-panel"
       data-level="{{ item.badge_level | level_display(item.badge_year) }}"
       data-name="{{ player_name }}">
        <div class="player-header">
            <div class="avatar">
                {# 頭像：原生 loading="lazy"，失敗 fallback 見 avatar-fallback.js #}
                {% set cdn_primary, cdn_secondary = headshot_cdn_urls(player.mlb_id, player.latest_level_is_mlb) %}
                <img src="{{ cdn_primary }}" data-cdn-src="{{ cdn_secondary }}" alt="{{ player_name }}" class="avatar-img" loading="lazy">
                <div class="avatar-initials avatar-fallback" aria-hidden="true">{{ player.name_en[:1] }}</div>
            </div>
            <div class="player-info">
                <h2>{{ player.name_tw or player.name_en }}
                    {% if item.badge_level %}
                    {{ tags.level_tag(item.badge_level, item.badge_year) }}
                    {% endif %}
                </h2>
                <div class="level">
                    {{ player.position }}{% if stat and stat.years_range %} · {{ stat.years_range }}{% endif %}
                </div>
            </div>
        </div>

        {% if stat %}
        <div class="stats-row">
            {% if player.is_pitcher %}
                <div class="stat-box">
                    <span class="stat-label">ERA</span>
                    <span class="stat-value">{{ stat.era|floatformat(2) }}</span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">WHIP</span>
                    <span class="stat-value">{{ stat.whip|floatformat(2) }}</span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">K</span>
                    <span class="stat-value">{{ stat.so|num_dash }}</span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">W-L</span>
                    <span class="stat-value">{{ stat.wins|num_dash }}-{{ stat.losses|num_dash }}</span>
                </div>
            {% else %}
                <div class="stat-box">
                    <span class="stat-label">AVG</span>
                    <span class="stat-value">{{ stat.avg|floatformat(3) }}</span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">HR</span>
                    <span class="stat-value">{{ stat.hr|num_dash }}</span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">OPS</span>
                    <span class="stat-value">{{ stat.ops|floatformat(3) }}</span>
                </div>
                <div class="stat-box">
                    <span class="stat-label">SB</span>
                    <span class="stat-value">{{ stat.sb|num_dash }}</span>
                </div>
            {% endif %}
        </div>
        {% else %}
        <div class="stats-row stats-row-empty">
            <div class="stat-box stat-box-full">
                <span class="stat-label">無生涯紀錄</span>
            </div>
        </div>
        {% endif %}
    </a>
    {% else %}
    <p class="empty-msg">目前沒有已離隊球員。</p>
    {% endfor %}
</div>

{# 搜尋無結果提示：放在 Grid 之外，內容由 player-search.js 填入 #}
<p class="empty-msg search-empty-msg" id="search-empty-msg" role="status" aria-live="polite" hidden></p>
{% endblock %}

{% block extra_scripts %}
<script defer src="{{ static_url('js/player-search.js') }}"></script>
{% endblock %}

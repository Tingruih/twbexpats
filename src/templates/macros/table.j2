{# 共用 <th> 欄位標頭 macro，集中欄位說明（tooltip）的標記方式 #}

{% macro th(label, tooltip=None, formula=None) -%}
<th{% if tooltip %} data-tooltip="{{ tooltip|e }}"{% endif %}{% if formula %} data-formula="{{ formula|e }}"{% endif %}>{{ label }}</th>
{%- endmacro %}

{# 打者「對戰球種」表格（逐球種 / 三大類皆共用同一組欄位） #}
{% macro vs_pitch_table(rows, tags, type_header='球種', type_tooltip=None) %}
{% set _type_tip = type_tooltip if type_tooltip else ('Fastball : FF, SI, FC, FA, FT\\nBreaking : SL, ST, SV, CU, CB, KC, CS, SC\\nOffSpeed : CH, FS, FO, KN, EP' if type_header == '分類' else '球種名稱') %}
<table class="data-table">
    <thead>
        <tr>
            {{ th(type_header, _type_tip) }}{{ th('Pitches', '該球種/分類總球數') }}{{ th('Strike%', '好球率\\n界外球或場內擊球不論安打或出局也算Strikes', '\\mathrm{\\frac{Strikes}{Pitches}}') }}{{ th('Zone%', '好球帶率', '\\frac{\\mathrm{InZone}}{\\mathrm{InZone}+\\mathrm{OutZone}}') }}
            {{ th('Z-Swing%', '好球帶內揮棒率', '\\frac{\\mathrm{InZoneSwings}}{\\mathrm{InZonePitches}}') }}{{ th('O-Swing%', '壞球追打率', '\\frac{\\mathrm{OutZoneSwings}}{\\mathrm{OutZonePitches}}') }}{{ th('Whiff%', '出棒揮空率', '\\frac{\\mathrm{Whiffs}}{\\mathrm{Swings}}') }}{{ th('SwStr%', '投球揮空率', '\\frac{\\mathrm{Whiffs}}{\\mathrm{Pitches}}') }}
            {{ th('CSW%', '看球與揮空率','\\frac{\\mathrm{CalledStrikes}\\text(看球好球數)+\\mathrm{Whiffs}}{\\mathrm{Pitches}}') }}{{ th('Put Away%', '兩好球後三振率', '\\frac{\\mathrm{TwoStrikeK}}{\\mathrm{TwoStrikePitches}}') }}{{ th('AVG', '打擊率', '\\frac{H}{AB}') }}{{ th('wOBA', '加權上壘率\\n此數據權重與TJStats相同', '\\mathrm{\\frac{w_{BB}\\times (BB-IBB)+w_{HBP}\\times HBP+w_{1B}\\times 1B+w_{2B}\\times 2B+w_{3B}\\times 3B+w_{HR}\\times HR}{AB+BB-IBB+SF+HBP}}') }}
            {{ th('Barrel%', 'Barrel 定義：\\nEV 98mph時，LA 須落在26°–30°\\n每增加1 mph，角度下限降1°（下限8°）、上限升1.5°（上限50°）','\\mathrm{\\frac{Barrels}{BBE_{ev}\\text{(打進場內球數)}}}') }}{{ th('Hard-Hit%', 'Hard-Hit定義：\\n EV≥95 mph', '\\frac{\\mathrm{HardHit}}{\\mathrm{BBE}_{ev}\\text{(打進場內球數)}}') }}
        </tr>
    </thead>
    <tbody>
        {% for pt in rows %}
        <tr>
            <td>{{ tags.pitch_tag(pt.type, pt.name) }}</td>
            <td class="num">{{ pt.count|num_dash }}</td>
            <td class="num">{{ pt.strike_pct|pct_fmt }}</td>
            <td class="num">{{ pt.zone_pct|pct_fmt }}</td>
            <td class="num">{{ pt.z_swing_pct|pct_fmt }}</td>
            <td class="num">{{ pt.o_swing_pct|pct_fmt }}</td>
            <td class="num">{{ pt.whiff_pct|pct_fmt }}</td>
            <td class="num">{{ pt.swstr_pct|pct_fmt }}</td>
            <td class="num">{{ pt.csw_pct|pct_fmt }}</td>
            <td class="num">{{ pt.put_away_pct|pct_fmt }}</td>
            <td class="num">{{ pt.avg|floatformat(3) }}</td>
            <td class="num">{{ pt.woba|floatformat(3) }}</td>
            <td class="num">{{ pt.barrel_pct|pct_fmt }}</td>
            <td class="num">{{ pt.hard_hit_pct|pct_fmt }}</td>
        </tr>
        {% else %}
        <tr><td colspan="14" class="td-empty">尚無數據</td></tr>
        {% endfor %}
    </tbody>
</table>
{% endmacro %}

{# 「各球數配球比例」表格（逐球種 / 三大類皆共用同一組欄位） #}
{% macro usage_by_count_table(usage_types, usage_rows, tags, type_header='球種', type_tooltip=None) %}
{% if usage_types and usage_rows %}
{% set _type_tip = type_tooltip if type_tooltip else ('Fastball : FF, SI, FC, FA, FT\\nBreaking : SL, ST, SV, CU, CB, KC, CS, SC\\nOffSpeed : CH, FS, FO, KN, EP' if type_header == '分類' else '球種名稱') %}
<div class="table-scroll">
    <table class="data-table pitch-usage-table">
        <thead>
            <tr>
                {{ th(type_header, _type_tip) }}
                {% for row in usage_rows %}
                {% if row.key != 'all' %}
                <th>{{ row.label }}<br><span class="pitch-usage-subhead">{{ row.counts_label }}</span></th>
                {% endif %}
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for pitch in usage_types %}
            <tr>
                <td>{{ tags.pitch_tag(pitch.type, pitch.name) }}</td>
                {% for row in usage_rows %}
                {% if row.key != 'all' %}
                {% set pitch_cell = namespace(pct=none) %}
                {% for pt in row.pitch_types %}
                {% if pt.type == pitch.type %}
                {% set pitch_cell.pct = pt.pct %}
                {% endif %}
                {% endfor %}
                <td class="num">{{ pitch_cell.pct|pct_fmt }}</td>
                {% endif %}
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% else %}
<div class="pitch-analysis-empty">無球種資料</div>
{% endif %}
{% endmacro %}

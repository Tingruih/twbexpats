{# ── TAB 6: PLOT ── #}
<div class="tab-panel" id="panel-plot">
    {% if player_trend_by_year %}
    <div class="chart-wrap glass-panel pitcher-trend-wrap">
        <h3>賽季走勢圖</h3>
        <div class="log-filter-bar pitcher-trend-filter-bar">
            <label class="filter-label" for="trend-stat-select">數據</label>
            <select id="trend-stat-select" class="filter-select">
                {% for key, label in trend_stat_options %}
                <option value="{{ key }}"{% if loop.first %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <label class="filter-label" for="trend-year-select">年度</label>
            <select id="trend-year-select" class="filter-select">
                {% for yr in player_trend_by_year %}
                <option value="{{ yr }}"{% if loop.first %} selected{% endif %}>{{ yr }}</option>
                {% endfor %}
            </select>
            <label class="filter-label" for="trend-level-select">層級</label>
            <select id="trend-level-select" class="filter-select"></select>
        </div>
        <div id="trend-chart-legend" class="trend-chart-legend"></div>
        <div id="trend-chart-empty" class="trend-chart-empty" role="status" hidden></div>
        <canvas id="performanceChart" height="80"></canvas>
    </div>
    {% endif %}

    {% if statcast_available %}
    <div class="chart-wrap glass-panel pitch-plinko-wrap">
        <div class="log-filter-bar pitch-plinko-filter-bar">
            <label class="filter-label" for="plinko-year-select">年度</label>
            <select id="plinko-year-select" class="filter-select">
                {% for yr in available_statcast_years %}
                <option value="{{ yr }}"{% if loop.first %} selected{% endif %}>{{ yr }}</option>
                {% endfor %}
            </select>
            <label class="filter-label" for="plinko-level-select">層級</label>
            <select id="plinko-level-select" class="filter-select"></select>
        </div>

        {% for yr in available_statcast_years %}
        {% set _entries = statcast_by_year[yr] %}
        <div class="pitch-plinko-year-container" id="plinko-{{ yr }}" {% if not loop.first %}style="display: none;"{% endif %}>
            {# data-chart-key matches the #chart-data-{kind}-{{ yr }}-{{ loop.index0 }}
               ids rendered once by partials/chart_data.j2. #}
            {% for _e in _entries %}
            {% set _level = _e.sport_level %}
            <div class="pitch-plinko-level-container"
                 data-level="{{ _level | level_display(yr) }}"
                 data-level-label="{% if _level == '_combined' %}All Levels{% else %}{{ _level | level_display(yr) }}{% endif %}"
                 data-chart-key="{{ yr }}-{{ loop.index0 }}"
                 {% if not loop.first %}style="display: none;"{% endif %}>
                {% if is_pitcher %}
                <div class="pitch-chart-grid">
                    <section class="pitch-chart-section">
                        <div class="pitch-usage-hand-root"></div>
                    </section>
                    <section class="pitch-chart-section">
                        <div class="pitch-movement-root"></div>
                    </section>
                </div>
                {% endif %}
                <div class="pitch-plinko-root"></div>
            </div>
            {% endfor %}
        </div>
        {% endfor %}
    </div>
    {% elif not player_trend_by_year %}
    <div class="glass-panel" style="padding:2rem;text-align:center;color:var(--text-2);">
        尚無本賽季數據圖表
    </div>
    {% endif %}
</div>
